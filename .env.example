# Application
EDUKNOWLEDGE_APP_NAME=EduKnowledge AI
EDUKNOWLEDGE_ENVIRONMENT=development
EDUKNOWLEDGE_DEBUG=false
EDUKNOWLEDGE_LOG_LEVEL=INFO
EDUKNOWLEDGE_HOST=0.0.0.0
EDUKNOWLEDGE_PORT=8000
EDUKNOWLEDGE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dependencies (credentials are for local development only; never commit real secrets)
EDUKNOWLEDGE_DATABASE_URL=postgresql+asyncpg://eduknowledge:eduknowledge@localhost:5432/eduknowledge
EDUKNOWLEDGE_REDIS_URL=redis://localhost:6379/0

# Future authentication configuration. Supply a long unique secret outside development.
EDUKNOWLEDGE_JWT_SECRET_KEY=replace-with-a-long-random-secret
EDUKNOWLEDGE_JWT_ALGORITHM=HS256
EDUKNOWLEDGE_JWT_ACCESS_TOKEN_MINUTES=30
